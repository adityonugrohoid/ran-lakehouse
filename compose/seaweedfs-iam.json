{
  "identities": [
    {
      "name": "lakehouse",
      "credentials": [
        {
          "accessKey": "local-dev-key",
          "secretKey": "local-dev-secret-not-a-real-credential"
        }
      ],
      "actions": ["Read", "List", "Tagging", "Write"]
    }
  ],
  "sts": {
    "tokenDuration": "1h",
    "maxSessionLength": "12h",
    "issuer": "seaweedfs-sts",
    "signingKey": "bG9jYWwtZGV2LXN0cy1zaWduaW5nLWtleS1ub3QtYS1zZWNyZXQ="
  },
  "roles": [
    {
      "roleName": "LakekeeperVendedRole",
      "roleArn": "arn:aws:iam::000000000000:role/LakekeeperVendedRole",
      "trustPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {"Effect": "Allow", "Principal": "*", "Action": "sts:AssumeRole"}
        ]
      },
      "attachedPolicies": ["FullAccess"]
    }
  ],
  "policies": [
    {
      "name": "FullAccess",
      "document": {
        "Version": "2012-10-17",
        "Statement": [{"Effect": "Allow", "Action": "*", "Resource": "*"}]
      }
    }
  ]
}
